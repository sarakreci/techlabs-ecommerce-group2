# ============================================================
# 8. Outlier detection using the IQR method
# ============================================================
def find_outliers_iqr(data, col):
    Q1 = data[col].quantile(0.25)
    Q3 = data[col].quantile(0.75)
    IQR = Q3 - Q1
    lower = Q1 - 1.5 * IQR
    upper = Q3 + 1.5 * IQR
    outliers = data[(data[col] < lower) | (data[col] > upper)]
    print(f"{col}: bounds ({lower:.2f}, {upper:.2f}) -> outlier count: {len(outliers)} ({len(outliers)/len(data)*100:.2f}%)")
    return outliers, lower, upper

price_outliers, price_lower, price_upper = find_outliers_iqr(df, 'Price')
qty_outliers, qty_lower, qty_upper = find_outliers_iqr(df, 'Quantity')


